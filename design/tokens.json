{
  "$description": "Design tokens for the app. Source of truth for web (mirrored by hand in app/globals.css) and for the future iOS/Android widgets. See DESIGN.md for how to use them. If you change a value here, change it in app/globals.css too.",

  "color": {
    "light": {
      "bg":          "#F7F2F6",
      "surface":     "#FFFFFF",
      "sunken":      "#EEE6EE",
      "line":        "#E2D7E2",
      "ink":         "#2A1D2C",
      "ink-muted":   "#6E5F70",
      "accent":      "#C2364F",
      "on-accent":   "#FFFFFF",
      "you":         "#E14D63",
      "partner":     "#B8740F"
    },
    "dark": {
      "bg":          "#17121C",
      "surface":     "#211A27",
      "sunken":      "#110D15",
      "line":        "#33293A",
      "ink":         "#F4ECF3",
      "ink-muted":   "#ADA0B2",
      "accent":      "#FF7C8F",
      "on-accent":   "#17121C",
      "you":         "#FF7C8F",
      "partner":     "#FFBE5C"
    }
  },

  "mood": {
    "happy":       { "light": "#B07A0A", "dark": "#FFC94D", "label": "Happy" },
    "loved":       { "light": "#D9465F", "dark": "#FF8099", "label": "Loved" },
    "calm":        { "light": "#3F9483", "dark": "#7FD1BD", "label": "Calm" },
    "excited":     { "light": "#E0632E", "dark": "#FF9A63", "label": "Excited" },
    "tired":       { "light": "#7F6FB8", "dark": "#B3A6E8", "label": "Tired" },
    "sad":         { "light": "#4A72B0", "dark": "#8DB0EB", "label": "Sad" },
    "stressed":    { "light": "#B8483A", "dark": "#F08471", "label": "Stressed" },
    "missing_you": { "light": "#A1508E", "dark": "#E39AD3", "label": "Missing you" }
  },

  "font": {
    "display": { "web": "Fredoka", "ios": "SF Pro Rounded", "android": "Fredoka (bundled)" },
    "body":    { "web": "Figtree", "ios": "SF Pro", "android": "Roboto / system" }
  },

  "type-scale-px": {
    "caption": 12,
    "small":   14,
    "body":    16,
    "lead":    20,
    "title":   25,
    "heading": 31,
    "display": 48,
    "hero":    88
  },

  "space-px": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64 },

  "radius-px": { "sm": 10, "md": 16, "lg": 28, "full": 9999 },

  "motion": {
    "duration-ms": { "quick": 150, "base": 250, "settle": 450, "count": 900, "breathe": 4000 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out":      "cubic-bezier(0.16, 1, 0.3, 1)",
      "pop":      "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  }
}
