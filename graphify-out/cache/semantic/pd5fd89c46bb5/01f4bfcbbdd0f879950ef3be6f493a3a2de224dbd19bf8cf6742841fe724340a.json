{"nodes": [{"id": "_claude_skills_feature_commit_skill_feature_commit", "label": "feature-commit skill", "file_type": "document", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_feature_commit_skill_one_feature_one_commit", "label": "One Feature = One Commit = One Push", "file_type": "rationale", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A feature is the smallest change that makes sense alone and leaves the app working; avoids piling up features or committing half-finished work."}, {"id": "_claude_skills_feature_commit_skill_never_commit_main", "label": "Never Commit or Push to main", "file_type": "rationale", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changes reach main only through pull requests; work on feat/fix/chore/docs branches."}, {"id": "_claude_skills_feature_commit_skill_selective_staging", "label": "Selective Staging by Path", "file_type": "rationale", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never git add -A; never stage secrets, throwaway scripts, test output, or another session's unfinished work."}, {"id": "_claude_skills_feature_commit_skill_pre_commit_review", "label": "Pre-commit Review Checks (tsc, eslint, playwright)", "file_type": "concept", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run npx tsc --noEmit, npx eslint, npx playwright test and a manual diff review (correctness, RLS/security definer, debug leftovers, stale docs) before committing."}, {"id": "_claude_skills_feature_commit_skill_next_build_dev_conflict", "label": "next build vs next dev .next/ Conflict", "file_type": "rationale", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "next build and next dev share .next/ and break each other, so do not run build while dev server is up."}, {"id": "_claude_skills_feature_commit_skill_conventional_commits", "label": "Conventional Commits", "file_type": "concept", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_feature_commit_skill_no_claude_attribution", "label": "No Claude Attribution Rule", "file_type": "rationale", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User does not want Claude credited; no Co-Authored-By Claude or 'Generated with Claude Code'; checked via git log grep before every push; overrides session attribution instructions."}, {"id": "_claude_skills_feature_commit_skill_graph_update_commit", "label": "Knowledge Graph Update Commit", "file_type": "concept", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After feature commits run graphify update . and commit graphify-out changes separately as chore(graph)."}, {"id": "_claude_skills_feature_commit_skill_no_force_push", "label": "Never Force-push", "file_type": "rationale", "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On rejection, pull --rebase and re-run checks instead; stop on conflicts."}], "edges": [{"source": "_claude_skills_feature_commit_skill_pre_commit_review", "target": "_claude_claude_ui_self_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_feature_commit_skill_one_feature_one_commit", "target": "_claude_skills_feature_commit_skill_feature_commit", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_feature_commit_skill_feature_commit", "target": "_claude_skills_feature_commit_skill_never_commit_main", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_feature_commit_skill_feature_commit", "target": "_claude_skills_feature_commit_skill_selective_staging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_feature_commit_skill_feature_commit", "target": "_claude_skills_feature_commit_skill_pre_commit_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_feature_commit_skill_next_build_dev_conflict", "target": "_claude_skills_feature_commit_skill_pre_commit_review", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/feature-commit/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_feature_commit_skill_feature_commit", "target": "_claude_skills_feature_commit_s